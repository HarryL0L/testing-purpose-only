#version 450
// memory bandwidth: each invocation copies one vec4 (16 bytes read + 16 written)
layout(local_size_x = 256) in;
layout(push_constant) uniform P { uint iters; } p;
layout(std430, binding = 0) writeonly buffer O { vec4 o[]; };
layout(std430, binding = 1) readonly buffer I { vec4 a[]; };
void main() { uint i = gl_GlobalInvocationID.x; o[i] = a[i]; }
