#version 450
#extension GL_EXT_shader_16bit_storage : require
// 16-bit storage (what ggml relies on): read fp16 values, write them doubled as fp32
layout(local_size_x = 64) in;
layout(push_constant) uniform P { uint iters; } p;
layout(std430, binding = 0) buffer O { float o[]; };
layout(std430, binding = 1) buffer I { float16_t a[]; };
void main() { uint i = gl_GlobalInvocationID.x; o[i] = float(a[i]) * 2.0; }
