# cmake -DIN=x.spv -DOUT=x.h -DNAME=spv_x -P bin2h.cmake : SPIR-V words as a C array
file(READ ${IN} hex HEX)
string(LENGTH "${hex}" len)
math(EXPR words "${len} / 8")
set(body "")
set(i 0)
while(i LESS len)
    string(SUBSTRING "${hex}" ${i} 8 w)
    # file bytes are little-endian: reverse them into a uint32 literal
    string(SUBSTRING "${w}" 6 2 b3)
    string(SUBSTRING "${w}" 4 2 b2)
    string(SUBSTRING "${w}" 2 2 b1)
    string(SUBSTRING "${w}" 0 2 b0)
    string(APPEND body "0x${b3}${b2}${b1}${b0},")
    math(EXPR i "${i} + 8")
    math(EXPR m "${i} % 64")
    if(m EQUAL 0)
        string(APPEND body "\n")
    endif()
endwhile()
file(WRITE ${OUT} "static const uint32_t ${NAME}[] = {\n${body}};\nstatic const size_t ${NAME}_size = sizeof(${NAME});\n")
