#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : enable
// rows x cols matrix (row stride `cols`) -> cols x rows f16 matrix.
// Each invocation moves one 8 x 8 block through registers: eight 16-byte loads (8 halfs, or 2 x 4
// floats), an in-register transpose, eight 16-byte stores. No shared memory: on Mali it goes through
// the same load/store path as normal memory, so staging a tile there only adds traffic (a 16 x 16
// shared-memory version measured ~3.5 GB/s on a Mali-G77, out of ~26).
// SRC_F32 1: f32 input (activations, f32 weights), 0: f16 input.
// The output can be padded: rows_out x cols_out (multiples of 8) from a rows_valid x cols_valid source
// (cols_valid a multiple of 8); the padding is written as zeros, so a padded K adds nothing to the
// GEMM and padded N columns are simply not stored by it.
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant) uniform P { uint rows, cols, rows_valid, cols_valid; } p; // rows / cols: padded
#if SRC_F32
layout(std430, binding = 0) readonly buffer S { vec4 s[]; };
#else
layout(std430, binding = 0) readonly buffer S { uvec4 s[]; };
#endif
layout(std430, binding = 1) writeonly buffer D { uvec4 d[]; };

void main() {
    const uint bc = gl_GlobalInvocationID.x, br = gl_GlobalInvocationID.y; // block column / row (of 8)
    if (bc * 8 >= p.cols || br * 8 >= p.rows) return;
    const bool col_ok = bc * 8 < p.cols_valid;
    // v[r][c]: row br*8 + r, column bc*8 + c
    f16vec2 v[8][4];
    [[unroll]] for (uint r = 0; r < 8; r++) {
        const uint row = br * 8 + r;
        if (!col_ok || row >= p.rows_valid) {
            v[r][0] = v[r][1] = v[r][2] = v[r][3] = f16vec2(0);
            continue;
        }
#if SRC_F32
        const vec4 x0 = s[(row * p.cols_valid + bc * 8) / 4];
        const vec4 x1 = s[(row * p.cols_valid + bc * 8) / 4 + 1];
        v[r][0] = f16vec2(x0.xy); v[r][1] = f16vec2(x0.zw);
        v[r][2] = f16vec2(x1.xy); v[r][3] = f16vec2(x1.zw);
#else
        const uvec4 x = s[(row * p.cols_valid + bc * 8) / 8];
        v[r][0] = unpackFloat2x16(x.x); v[r][1] = unpackFloat2x16(x.y);
        v[r][2] = unpackFloat2x16(x.z); v[r][3] = unpackFloat2x16(x.w);
#endif
    }
    // output row = input column c, 8 halfs = input rows br*8 .. br*8+7
    [[unroll]] for (uint c = 0; c < 8; c++) {
        const uint h = c / 2;
        uvec4 o;
        if ((c & 1) == 0) {
            o.x = packFloat2x16(f16vec2(v[0][h].x, v[1][h].x));
            o.y = packFloat2x16(f16vec2(v[2][h].x, v[3][h].x));
            o.z = packFloat2x16(f16vec2(v[4][h].x, v[5][h].x));
            o.w = packFloat2x16(f16vec2(v[6][h].x, v[7][h].x));
        } else {
            o.x = packFloat2x16(f16vec2(v[0][h].y, v[1][h].y));
            o.y = packFloat2x16(f16vec2(v[2][h].y, v[3][h].y));
            o.z = packFloat2x16(f16vec2(v[4][h].y, v[5][h].y));
            o.w = packFloat2x16(f16vec2(v[6][h].y, v[7][h].y));
        }
        d[((bc * 8 + c) * p.rows + br * 8) / 8] = o;
    }
}
