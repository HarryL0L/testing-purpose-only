<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Material 3 Expressive. The brand colours below are only the fallback: on Android 12+
        DynamicColors (see MochiApp) swaps in Material You colours from the wallpaper.
    -->
    <style name="Theme.Mochi" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="colorPrimary">#5B5BD6</item>
        <item name="colorSecondary">#7C6FA6</item>
        <item name="colorTertiary">#C2577F</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Mochi.Calibrate">
        <item name="android:windowBackground">#FFF2F2F7</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
