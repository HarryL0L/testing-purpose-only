+void SecretServiceClient::openCollection(const QString &collectionName, qlonglong windowId, const std::function<void(bool)> &callback)
+{
+    bool ok = false;
+    const QStringList collections = listCollections(&ok);
+    if (!ok) {
+        callback(false);
+        return;
+    }
+
+    if (collections.contains(collectionName)) {
+        unlockCollectionAsync(collectionName, windowId, callback);
+        return;
+    }
+
+    // Ask the service directly rather than through secret_collection_create_sync():
+    // that one runs the prompt itself and only comes back when the user is done.
+    QDBusMessage call = QDBusMessage::createMethodCall(m_serviceBusName,
+                                                       QStringLiteral("/org/freedesktop/secrets"),
+                                                       QStringLiteral("org.freedesktop.Secret.Service"),
+                                                       QStringLiteral("CreateCollection"));
+    call << QVariantMap{{QStringLiteral("org.freedesktop.Secret.Collection.Label"), collectionName}} << QString();
+
+    auto watcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(call), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this, collectionName, windowId, callback](QDBusPendingCallWatcher *watcher) {
+        watcher->deleteLater();
+
+        const QDBusPendingReply<QDBusObjectPath, QDBusObjectPath> reply = *watcher;
+        if (reply.isError()) {
+            qCWarning(KWALLETD_LOG) << "Failed to create collection" << collectionName << reply.error().message();
+            callback(false);
+            return;
+        }
+
+        const auto created = [this, collectionName, windowId, callback](bool accepted) {
+            if (accepted) {
+                unlockCollectionAsync(collectionName, windowId, callback);
+            } else {
+                callback(false);
+            }
+        };
+
+        const QString promptPath = reply.argumentAt<1>().path();
+        if (promptPath == QLatin1String("/")) {
+            created(true);
+        } else {
+            runPrompt(promptPath, windowId, created);
+        }
+    });
+}
+
+void SecretServiceClient::unlockCollectionAsync(const QString &collectionName, qlonglong windowId, const std::function<void(bool)> &callback)
+{
+    SecretCollection *collection = retrieveCollection(collectionName);
+    if (!collection) {
+        callback(false);
+        return;
+    }
+
+    bool ok = false;
+    watchCollection(collectionName, &ok);
+    if (!ok) {
+        callback(false);
+        return;
+    }
+
+    const QString path = QString::fromUtf8(g_dbus_proxy_get_object_path(G_DBUS_PROXY(collection)));
+
+    // Ask the service whether it is locked, what libsecret has cached can be out of date
+    QDBusInterface collectionInterface(m_serviceBusName, path, QStringLiteral("org.freedesktop.Secret.Collection"), QDBusConnection::sessionBus());
+    const QVariant locked = collectionInterface.property("Locked");
+    if (!locked.isValid()) {
+        qCWarning(KWALLETD_LOG) << "Error reading locked:" << collectionInterface.lastError();
+        callback(false);
+        return;
+    }
+    if (!locked.toBool()) {
+        callback(true);
+        return;
+    }
+
+    QDBusMessage call = QDBusMessage::createMethodCall(m_serviceBusName,
+                                                       QStringLiteral("/org/freedesktop/secrets"),
+                                                       QStringLiteral("org.freedesktop.Secret.Service"),
+                                                       QStringLiteral("Unlock"));
+    call << QVariant::fromValue(QList<QDBusObjectPath>{QDBusObjectPath(path)});
+
+    auto watcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(call), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this, collectionName, path, windowId, callback](QDBusPendingCallWatcher *watcher) {
+        watcher->deleteLater();
+
+        const QDBusPendingReply<QList<QDBusObjectPath>, QDBusObjectPath> reply = *watcher;
+        if (reply.isError()) {
+            qCWarning(KWALLETD_LOG) << i18n("Unable to unlock collectionName %1", collectionName) << reply.error().message();
+            callback(false);
+            return;
+        }
+
+        const QString promptPath = reply.argumentAt<1>().path();
+        if (promptPath == QLatin1String("/")) {
+            callback(reply.argumentAt<0>().contains(QDBusObjectPath(path)));
+        } else {
+            runPrompt(promptPath, windowId, callback);
+        }
+    });
+}
+
+// Shows a Secret Service prompt and reports whether the user went through with
+// it. We only ever have one of these going, open requests are handled one at a
+// time. The window id of the application that asked is passed along so that
+// the dialog can be attached to its window.
+void SecretServiceClient::runPrompt(const QString &promptPath, qlonglong windowId, const std::function<void(bool)> &callback)
+{
+    m_promptPath = promptPath;
+    m_promptCallback = callback;
+
+    QDBusConnection bus = QDBusConnection::sessionBus();
+    bus.connect(m_serviceBusName,
+                promptPath,
+                QStringLiteral("org.freedesktop.Secret.Prompt"),
+                QStringLiteral("Completed"),
+                this,
+                SLOT(onPromptCompleted(bool, QDBusVariant)));
+
+    QDBusMessage call =
+        QDBusMessage::createMethodCall(m_serviceBusName, promptPath, QStringLiteral("org.freedesktop.Secret.Prompt"), QStringLiteral("Prompt"));
+    call << QString::number(windowId);
+
+    auto watcher = new QDBusPendingCallWatcher(bus.asyncCall(call), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, [this, promptPath](QDBusPendingCallWatcher *watcher) {
+        watcher->deleteLater();
+
+        if (watcher->isError() && m_promptPath == promptPath) {
+            qCWarning(KWALLETD_LOG) << "Failed to show prompt" << promptPath << watcher->error().message();
+            finishPrompt(false);
+        }
+    });
+}
+
+void SecretServiceClient::onPromptCompleted(bool dismissed, const QDBusVariant &result)
+{
+    Q_UNUSED(result);
+    finishPrompt(!dismissed);
+}
+
+void SecretServiceClient::finishPrompt(bool accepted)
+{
+    if (!m_promptCallback) {
+        return;
+    }
+
+    QDBusConnection::sessionBus().disconnect(m_serviceBusName,
+                                             m_promptPath,
+                                             QStringLiteral("org.freedesktop.Secret.Prompt"),
+                                             QStringLiteral("Completed"),
+                                             this,
+                                             SLOT(onPromptCompleted(bool, QDBusVariant)));
+
+    const std::function<void(bool)> callback = m_promptCallback;
+    m_promptCallback = nullptr;
+    m_promptPath.clear();
+
+    callback(accepted);
+}
