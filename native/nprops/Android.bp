// Android's property service for native mode (see nprops.cpp).
// Copied into the AOSP checkout by .github/workflows/bionic.yml.

cc_binary {
    name: "nprops",
    srcs: ["nprops.cpp"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    // Static, like init: the property-writing calls (__system_property_add,
    // ...) are platform-only and not in the libc that dynamic programs link.
    static_executable: true,
    static_libs: [
        "libbase",
        "liblog",
        "libpropertyinfoparser",
        "libpropertyinfoserializer",
    ],
}
