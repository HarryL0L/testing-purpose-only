// KDE Plasma 6.8 in GitHub Codespaces.
//
// The Codespace itself runs on GitHub's standard image (Docker included).
// The Plasma VM is a separate Docker container started by ./start.sh once
// the Codespace is up, so Codespace creation never waits on the VM.
{
  "name": "KDE Plasma 6.8 (KDE neon VM)",
  "image": "mcr.microsoft.com/devcontainers/universal:2",

  "forwardPorts": [8006],
  "portsAttributes": {
    "8006": {
      "label": "KDE Plasma desktop (web viewer)",
      "onAutoForward": "openBrowser"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },

  // Start (or restart) the VM every time the Codespace starts.
  "postStartCommand": "bash ./start.sh"
}
