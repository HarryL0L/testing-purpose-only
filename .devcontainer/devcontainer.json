// KDE Plasma 6.8 in GitHub Codespaces.
//
// No image is named here on purpose: Codespaces then uses its cached default
// image and starts in about a minute. Naming an image forces a multi-GB pull
// on every new Codespace. The Plasma VM is a separate Docker container
// started by ./start.sh once the Codespace is up.
{
  "name": "KDE Plasma 6.8 (KDE neon VM)",

  "forwardPorts": [8006],
  "portsAttributes": {
    "8006": {
      "label": "KDE Plasma desktop (web viewer)",
      "onAutoForward": "openBrowser"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },

  // Start (or restart) the VM every time the Codespace starts.
  "postStartCommand": "bash ./start.sh"
}
