// Android 17 in GitHub Codespaces.
//
// No image is named here on purpose: Codespaces then uses its cached default
// image and starts in about a minute. The emulator runs in a separate Docker
// container started by ./start.sh once the Codespace is up.
{
  "name": "Android 17 emulator",

  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Android 17 (noVNC)",
      "onAutoForward": "openBrowser"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },

  // Build and start the emulator every time the Codespace starts.
  "postStartCommand": "bash ./start.sh"
}
