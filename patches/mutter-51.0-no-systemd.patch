diff -ruN a/config.h.meson b/config.h.meson
--- a/config.h.meson	2026-09-14 21:48:16.000000000 +0000
+++ b/config.h.meson	2026-10-20 06:24:18.620530457 +0000
@@ -46,6 +46,9 @@
 /* Defined if the devkit is enabled */
 #mesondefine HAVE_DEVKIT
 
+/* Defined if libsystemd or libelogind (sd-login) is available */
+#mesondefine HAVE_LOGIND
+
 /* Defined if gnome-desktop is enabled */
 #mesondefine HAVE_GNOME_DESKTOP
 
@@ -73,6 +76,7 @@
 /* Either <sys/random.h> or <linux/random.h> */
 #mesondefine HAVE_SYS_RANDOM
 #mesondefine HAVE_LINUX_RANDOM
+#mesondefine HAVE_ARC4RANDOM_BUF
 
 /* Whether Xwayland has -initfd option */
 #mesondefine HAVE_XWAYLAND_INITFD
diff -ruN a/meson.build b/meson.build
--- a/meson.build	2026-09-14 21:48:16.000000000 +0000
+++ b/meson.build	2026-10-20 06:24:03.531248292 +0000
@@ -222,15 +222,20 @@
   error('Wayland support requires EGL to be enabled')
 endif
 
-logind_dep = dependency('libsystemd', required: false)
+logind_opt = get_option('logind')
+logind_dep = dependency('', required: false)
+if not logind_opt.disabled()
+  logind_dep = dependency('libsystemd', required: false)
 
-if not logind_dep.found()
-  logind_dep = dependency('libelogind', required: false)
-endif
+  if not logind_dep.found()
+    logind_dep = dependency('libelogind', required: false)
+  endif
 
-if not logind_dep.found()
-  error('No logind provider dependency found: tried libsystemd and libelogind')
+  if not logind_dep.found() and logind_opt.enabled()
+    error('No logind provider dependency found: tried libsystemd and libelogind')
+  endif
 endif
+have_logind = logind_dep.found()
 
 libudev_dep = dependency('libudev', version: udev_req)
 gudev_dep = dependency('gudev-1.0', version: gudev_req)
@@ -547,6 +552,7 @@
 cdata.set('HAVE_XWAYLAND', have_xwayland)
 cdata.set('HAVE_REMOTE_DESKTOP', have_remote_desktop)
 cdata.set('HAVE_DEVKIT', have_devkit)
+cdata.set('HAVE_LOGIND', have_logind)
 cdata.set('HAVE_GNOME_DESKTOP', have_gnome_desktop)
 cdata.set('HAVE_SOUND_PLAYER', have_sound_player)
 cdata.set('HAVE_LIBWACOM', have_libwacom)
@@ -596,6 +602,9 @@
     cdata.set('HAVE_SYS_RANDOM', 1)
   elif cc.has_header_symbol('linux/random.h', 'getrandom')
     cdata.set('HAVE_LINUX_RANDOM', 1)
+  elif cc.has_header_symbol('stdlib.h', 'arc4random_buf')
+    # Android before API 28 (e.g. Termux) has no getrandom
+    cdata.set('HAVE_ARC4RANDOM_BUF', 1)
   else
     error('Required function getrandom not found')
   endif
@@ -735,6 +744,7 @@
 summary('XWayland', have_xwayland, section: 'Options')
 summary('Remote desktop', have_remote_desktop, section: 'Options')
 summary('Development Kit', have_devkit, section: 'Options')
+summary('logind (libsystemd/libelogind)', have_logind, section: 'Options')
 summary('libgnome-desktop', have_gnome_desktop, section: 'Options')
 summary('Sound player', have_sound_player, section: 'Options')
 summary('Wacom', have_libwacom, section: 'Options')
