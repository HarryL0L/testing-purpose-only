+package com.termux.x11.input;
+
+import static com.termux.x11.input.InputStub.BUTTON_LEFT;
+import static com.termux.x11.input.InputStub.BUTTON_MIDDLE;
+import static com.termux.x11.input.InputStub.BUTTON_RIGHT;
+import static com.termux.x11.input.InputStub.BUTTON_UNDEFINED;
+
+import android.annotation.SuppressLint;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+import android.util.AttributeSet;
+import android.util.SparseArray;
+import android.view.HapticFeedbackConstants;
+import android.view.KeyEvent;
+import android.view.MotionEvent;
+import android.view.View;
+
+import androidx.annotation.NonNull;
+
+import com.termux.x11.LorieView;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Onscreen gamepad drawn in the Xbox controller layout: two analog sticks (with LS/RS clicks),
+ * D-pad, A/B/X/Y, LB/RB, LT/RT, View, Menu and Guide buttons.
+ * X server has no virtual joystick device, so every control is translated to keyboard keys,
+ * mouse buttons, mouse wheel or relative mouse motion. Mapping is user configurable.
+ * Touches that do not hit any control fall through to the views below.
+ */
+public class GamepadOverlayView extends View {
+    public static final String DEFAULT_MAPPING =
+            "A=SPACE B=C X=R Y=E LB=Q RB=F LT=MOUSE_RIGHT RT=MOUSE_LEFT " +
+            "VIEW=TAB MENU=ESCAPE GUIDE=ENTER LS=SHIFT_LEFT RS=V " +
+            "DPAD_UP=UP DPAD_DOWN=DOWN DPAD_LEFT=LEFT DPAD_RIGHT=RIGHT " +
+            "LS_UP=W LS_DOWN=S LS_LEFT=A LS_RIGHT=D " +
+            "RS_UP=UP RS_DOWN=DOWN RS_LEFT=LEFT RS_RIGHT=RIGHT";
+
+    private static final int MOUSE_BASE = 0x10000;
+    private static final int WHEEL_UP = 0x20001, WHEEL_DOWN = 0x20002;
+    private static final float STICK_DEADZONE = 0.3f;
+    private static final int COLOR_A = 0xFF60B700, COLOR_B = 0xFFE81E25, COLOR_X = 0xFF2D7BD8, COLOR_Y = 0xFFF5C400;
+
+    private enum Kind { BUTTON, ROUND_BUTTON, STICK, DPAD, TOGGLE }
+
+    private class Control {
+        final Kind kind;
+        final String name, label;
+        final int color;
+        float cx, cy, r;           // round controls and D-pad
+        final RectF rect = new RectF(); // rectangular buttons
+        boolean pressed;
+        float sx, sy;              // stick deflection, -1..1
+        int dirMask;               // currently pressed directions of stick or D-pad
+        Control(Kind kind, String name, String label, int color) { this.kind = kind; this.name = name; this.label = label; this.color = color; }
+
+        boolean hit(float x, float y) {
+            if (kind == Kind.BUTTON)
+                return x >= rect.left - r * 0.25f && x <= rect.right + r * 0.25f && y >= rect.top - r * 0.25f && y <= rect.bottom + r * 0.25f;
+            float rr = (kind == Kind.STICK ? r * 1.35f : r * 1.12f);
+            return (x - cx) * (x - cx) + (y - cy) * (y - cy) <= rr * rr;
+        }
+    }
+
+    private final List<Control> controls = new ArrayList<>();
+    private final SparseArray<Control> pointers = new SparseArray<>();
+    private final Map<String, int[]> mapping = new HashMap<>();
+    private final Map<Integer, Integer> pressedCodes = new HashMap<>();
+    private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG), stroke = new Paint(Paint.ANTI_ALIAS_FLAG), text = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Path path = new Path();
+    private final RectF tmp = new RectF();
+    private Control leftStick, rightStick, dpad, toggle;
+    private LorieView lorieView;
+    private boolean collapsed = false, haptics = true;
+    private String leftStickMode = "keys", rightStickMode = "mouse";
+    private float sizeScale = 1f, mouseSpeed = 20f, mouseRemX, mouseRemY, unit;
+    private int insetTop, insetBottom;
+
+    private final Runnable mouseTicker = new Runnable() {
+        @Override public void run() {
+            boolean active = false;
+            for (Control c : new Control[] { leftStick, rightStick }) {
+                if (c == null || !"mouse".equals(c == leftStick ? leftStickMode : rightStickMode))
+                    continue;
+                float mag = (float) Math.hypot(c.sx, c.sy);
+                if (mag < 0.08f)
+                    continue;
+                active = true;
+                // Quadratic response curve gives precise aiming near center and fast turns at the edge.
+                float k = mouseSpeed * mag;
+                mouseRemX += c.sx * k;
+                mouseRemY += c.sy * k;
+            }
+            int dx = (int) mouseRemX, dy = (int) mouseRemY;
+            mouseRemX -= dx;
+            mouseRemY -= dy;
+            if ((dx != 0 || dy != 0) && lorieView != null)
+                lorieView.sendMouseEvent(dx, dy, BUTTON_UNDEFINED, false, true);
+            if (active)
+                postOnAnimation(this);
+            else
+                mouseRemX = mouseRemY = 0;
+        }
+    };
+
+    public GamepadOverlayView(Context context) { this(context, null); }
+    public GamepadOverlayView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        stroke.setStyle(Paint.Style.STROKE);
+        text.setTextAlign(Paint.Align.CENTER);
+        text.setFakeBoldText(true);
+        setMapping(DEFAULT_MAPPING);
+    }
+
+    public void setLorieView(LorieView view) { lorieView = view; }
+
+    public void configure(float scale, String leftMode, String rightMode, int speed, boolean vibrate, String mappingString) {
+        releaseAll();
+        sizeScale = scale;
+        leftStickMode = leftMode;
+        rightStickMode = rightMode;
+        mouseSpeed = Math.max(1, speed) * 0.5f;
+        haptics = vibrate;
+        setMapping(mappingString);
+        layoutControls(getWidth(), getHeight());
+        invalidate();
+    }
+
+    public void toggleCollapsed() {
+        releaseAll();
+        collapsed = !collapsed;
+        invalidate();
+    }
+
+    private void setMapping(String str) {
+        mapping.clear();
+        parseMapping(DEFAULT_MAPPING);
+        if (str != null)
+            parseMapping(str);
+    }
+
+    private void parseMapping(String str) {
+        for (String token : str.trim().split("[\\s,;]+")) {
+            int eq = token.indexOf('=');
+            if (eq <= 0)
+                continue;
+            String name = token.substring(0, eq).trim().toUpperCase(Locale.ROOT);
+            String[] parts = token.substring(eq + 1).split("\\+");
+            List<Integer> codes = new ArrayList<>();
+            for (String p : parts) {
+                int code = parseCode(p.trim().toUpperCase(Locale.ROOT));
+                if (code != 0)
+                    codes.add(code);
+            }
+            mapping.put(name, codes.stream().mapToInt(Integer::intValue).toArray());
+        }
+    }
+
+    private static int parseCode(String s) {
+        switch (s) {
+            case "": case "NONE": return 0;
+            case "MOUSE_LEFT": return MOUSE_BASE + BUTTON_LEFT;
+            case "MOUSE_MIDDLE": return MOUSE_BASE + BUTTON_MIDDLE;
+            case "MOUSE_RIGHT": return MOUSE_BASE + BUTTON_RIGHT;
+            case "WHEEL_UP": return WHEEL_UP;
+            case "WHEEL_DOWN": return WHEEL_DOWN;
+            case "ESC": s = "ESCAPE"; break;
+            case "SHIFT": s = "SHIFT_LEFT"; break;
+            case "CTRL": s = "CTRL_LEFT"; break;
+            case "ALT": s = "ALT_LEFT"; break;
+            case "UP": case "DOWN": case "LEFT": case "RIGHT": s = "DPAD_" + s; break;
+            case "RETURN": s = "ENTER"; break;
+            case "BACKSPACE": case "BKSP": s = "DEL"; break;
+            case "DELETE": s = "FORWARD_DEL"; break;
+            case "PGUP": s = "PAGE_UP"; break;
+            case "PGDN": s = "PAGE_DOWN"; break;
+            case "END": s = "MOVE_END"; break;
+            case "HOME": s = "MOVE_HOME"; break;
+        }
+        int code = KeyEvent.keyCodeFromString(s.startsWith("KEYCODE_") ? s : "KEYCODE_" + s);
+        return code == KeyEvent.KEYCODE_UNKNOWN ? 0 : code;
+    }
+
+    /** Keeps the pad clear of the extra keys bar, which is drawn over this view. */
+    public void setInsets(int top, int bottom) {
+        if (top == insetTop && bottom == insetBottom)
+            return;
+        insetTop = top;
+        insetBottom = bottom;
+        releaseAll();
+        layoutControls(getWidth(), getHeight());
+        invalidate();
+    }
+
+    private void layoutControls(int w, int fullHeight) {
+        controls.clear();
+        if (w == 0 || fullHeight == 0)
+            return;
+
+        // Controls are laid out from the bottom edge of the area left free by the insets.
+        int avail = fullHeight - insetTop - insetBottom, h = fullHeight - insetBottom;
+        if (avail <= 0)
+            return;
+        float u = unit = unit(w, avail), u0 = Math.min(avail / 10f, w / 17f);
+        float br = 0.6f * u, sr = 0.42f * u;
+
+        Control lt = add(Kind.BUTTON, "LT", "LT", 0), lb = add(Kind.BUTTON, "LB", "LB", 0);
+        Control rt = add(Kind.BUTTON, "RT", "RT", 0), rb = add(Kind.BUTTON, "RB", "RB", 0);
+        lt.rect.set(0.5f * u, h - 8.8f * u, 3.0f * u, h - 7.8f * u);
+        lb.rect.set(0.5f * u, h - 7.5f * u, 3.7f * u, h - 6.5f * u);
+        rt.rect.set(w - 3.0f * u, h - 8.8f * u, w - 0.5f * u, h - 7.8f * u);
+        rb.rect.set(w - 3.7f * u, h - 7.5f * u, w - 0.5f * u, h - 6.5f * u);
+        lt.r = lb.r = rt.r = rb.r = u;
+
+        leftStick = add(Kind.STICK, "LS", "", 0);
+        place(leftStick, 2.6f * u, h - 4.4f * u, 1.5f * u);
+        rightStick = add(Kind.STICK, "RS", "", 0);
+        place(rightStick, w - 6.2f * u, h - 1.9f * u, 1.3f * u);
+
+        dpad = add(Kind.DPAD, "DPAD", "", 0);
+        place(dpad, 6.2f * u, h - 1.9f * u, 1.6f * u);
+
+        float ax = w - 2.6f * u, ay = h - 4.4f * u, off = 1.15f * u;
+        place(add(Kind.ROUND_BUTTON, "Y", "Y", COLOR_Y), ax, ay - off, br);
+        place(add(Kind.ROUND_BUTTON, "X", "X", COLOR_X), ax - off, ay, br);
+        place(add(Kind.ROUND_BUTTON, "B", "B", COLOR_B), ax + off, ay, br);
+        place(add(Kind.ROUND_BUTTON, "A", "A", COLOR_A), ax, ay + off, br);
+
+        float mx = w / 2f, my = h - 4.4f * u;
+        place(add(Kind.ROUND_BUTTON, "LS", "LS", 0), mx - 3.2f * u, my, sr);
+        place(add(Kind.ROUND_BUTTON, "VIEW", "⧉", 0), mx - 1.5f * u, my, sr);
+        place(add(Kind.ROUND_BUTTON, "GUIDE", "Ⓧ", 0xFFFFFFFF), mx, my, 0.55f * u);
+        place(add(Kind.ROUND_BUTTON, "MENU", "≡", 0), mx + 1.5f * u, my, sr);
+        place(add(Kind.ROUND_BUTTON, "RS", "RS", 0), mx + 3.2f * u, my, sr);
+
+        toggle = add(Kind.TOGGLE, "TOGGLE", "🎮", 0);
+        place(toggle, w / 2f, insetTop + 0.6f * u0, 0.45f * u0);
+    }
+
+    /** Base size unit; the size preference can enlarge it only as long as the whole layout still fits the screen. */
+    private float unit(int w, int h) {
+        return Math.min(Math.min(h / 10f, w / 17f) * sizeScale, Math.min(h / 9.4f, w / 16f));
+    }
+
+    private Control add(Kind kind, String name, String label, int color) {
+        Control c = new Control(kind, name, label, color);
+        controls.add(c);
+        return c;
+    }
+
+    private static void place(Control c, float x, float y, float r) {
+        c.cx = x; c.cy = y; c.r = r;
+    }
+
+    @Override
+    protected void onSizeChanged(int w, int h, int oldw, int oldh) {
+        releaseAll();
+        layoutControls(w, h);
+    }
+
+    @Override
+    protected void onVisibilityChanged(@NonNull View changedView, int visibility) {
+        super.onVisibilityChanged(changedView, visibility);
+        if (visibility != VISIBLE)
+            releaseAll();
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        releaseAll();
+        super.onDetachedFromWindow();
+    }
+
+    private Control findControl(float x, float y) {
+        if (toggle != null && toggle.hit(x, y))
+            return toggle;
+        if (collapsed)
+            return null;
+        Control best = null;
+        float bestDist = Float.MAX_VALUE;
+        for (Control c : controls) {
+            if (c.kind == Kind.TOGGLE || !c.hit(x, y))
+                continue;
+            float d = c.kind == Kind.BUTTON ? Math.abs(x - c.rect.centerX()) + Math.abs(y - c.rect.centerY()) : (float) Math.hypot(x - c.cx, y - c.cy);
+            if (d < bestDist) {
+                bestDist = d;
+                best = c;
+            }
+        }
+        return best;
+    }
+
+    @SuppressLint("ClickableViewAccessibility")
+    @Override
+    public boolean onTouchEvent(MotionEvent e) {
+        int action = e.getActionMasked();
+        int idx = e.getActionIndex();
+        switch (action) {
+            case MotionEvent.ACTION_DOWN:
+            case MotionEvent.ACTION_POINTER_DOWN: {
+                Control c = findControl(e.getX(idx), e.getY(idx));
+                if (c == null)
+                    return action != MotionEvent.ACTION_DOWN; // let first finger fall through to X server
+                pointers.put(e.getPointerId(idx), c);
+                if (c.kind == Kind.TOGGLE)
+                    c.pressed = true;
+                else if (c.kind == Kind.STICK || c.kind == Kind.DPAD)
+                    updateDirectional(c, e.getX(idx), e.getY(idx));
+                else
+                    setButton(c, true);
+                if (haptics)
+                    performHapticFeedback(HapticFeedbackConstants.VIRTUAL_KEY, HapticFeedbackConstants.FLAG_IGNORE_VIEW_SETTING);
+                invalidate();
+                return true;
+            }
+            case MotionEvent.ACTION_MOVE:
+                for (int i = 0; i < e.getPointerCount(); i++) {
+                    Control c = pointers.get(e.getPointerId(i));
+                    if (c != null && (c.kind == Kind.STICK || c.kind == Kind.DPAD))
+                        updateDirectional(c, e.getX(i), e.getY(i));
+                }
+                invalidate();
+                return true;
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_POINTER_UP: {
+                int id = e.getPointerId(idx);
+                Control c = pointers.get(id);
+                pointers.remove(id);
+                if (c != null) {
+                    if (c.kind == Kind.TOGGLE) {
+                        c.pressed = false;
+                        if (toggle.hit(e.getX(idx), e.getY(idx)))
+                            toggleCollapsed();
+                    } else
+                        releaseControl(c);
+                }
+                invalidate();
+                return true;
+            }
+            case MotionEvent.ACTION_CANCEL:
+                releaseAll();
+                return true;
+        }
+        return true;
+    }
+
+    private void updateDirectional(Control c, float x, float y) {
+        float dx = (x - c.cx) / c.r, dy = (y - c.cy) / c.r;
+        float mag = (float) Math.hypot(dx, dy);
+        if (mag > 1) {
+            dx /= mag;
+            dy /= mag;
+            mag = 1;
+        }
+
+        int mask = 0;
+        if (c.kind == Kind.DPAD) {
+            // 8-way D-pad, with a small dead zone in the middle.
+            if (mag > 0.2f) {
+                double angle = Math.toDegrees(Math.atan2(dy, dx));
+                if (angle > -157.5 && angle < -22.5) mask |= 1;   // up
+                if (angle > 22.5 && angle < 157.5) mask |= 2;     // down
+                if (angle > 112.5 || angle < -112.5) mask |= 4;   // left
+                if (angle > -67.5 && angle < 67.5) mask |= 8;     // right
+            }
+            setDirections(c, mask, "DPAD");
+        } else {
+            c.sx = dx;
+            c.sy = dy;
+            String mode = c == leftStick ? leftStickMode : rightStickMode;
+            if ("keys".equals(mode)) {
+                if (dy < -STICK_DEADZONE) mask |= 1;
+                if (dy > STICK_DEADZONE) mask |= 2;
+                if (dx < -STICK_DEADZONE) mask |= 4;
+                if (dx > STICK_DEADZONE) mask |= 8;
+                setDirections(c, mask, c.name);
+            } else if ("mouse".equals(mode)) {
+                removeCallbacks(mouseTicker);
+                postOnAnimation(mouseTicker);
+            }
+        }
+    }
+
+    private static final String[] DIRS = { "_UP", "_DOWN", "_LEFT", "_RIGHT" };
+
+    private void setDirections(Control c, int mask, String prefix) {
+        int changed = mask ^ c.dirMask;
+        for (int i = 0; i < 4; i++) {
+            if ((changed & (1 << i)) == 0)
+                continue;
+            boolean down = (mask & (1 << i)) != 0;
+            sendCodes(mapping.get(prefix + DIRS[i]), down);
+        }
+        if (changed != 0 && mask != 0 && haptics && c.kind == Kind.DPAD)
+            performHapticFeedback(HapticFeedbackConstants.CLOCK_TICK, HapticFeedbackConstants.FLAG_IGNORE_VIEW_SETTING);
+        c.dirMask = mask;
+    }
+
+    private void setButton(Control c, boolean down) {
+        if (c.pressed == down)
+            return;
+        c.pressed = down;
+        sendCodes(mapping.get(c.name), down);
+    }
+
+    private void releaseControl(Control c) {
+        if (c.kind == Kind.STICK || c.kind == Kind.DPAD) {
+            setDirections(c, 0, c.kind == Kind.DPAD ? "DPAD" : c.name);
+            c.sx = c.sy = 0;
+        } else
+            setButton(c, false);
+        c.pressed = false;
+    }
+
+    private void releaseAll() {
+        removeCallbacks(mouseTicker);
+        pointers.clear();
+        for (Control c : controls) {
+            if (c.kind != Kind.TOGGLE)
+                releaseControl(c);
+            c.pressed = false;
+        }
+        // Anything still held (should not happen) is released too, so no key gets stuck in X server.
+        for (Integer code : new ArrayList<>(pressedCodes.keySet()))
+            sendRaw(code, false);
+        pressedCodes.clear();
+        invalidate();
+    }
+
+    private void sendCodes(int[] codes, boolean down) {
+        if (codes == null)
+            return;
+        // Press modifiers first and release them last.
+        for (int i = 0; i < codes.length; i++) {
+            int code = codes[down ? i : codes.length - 1 - i];
+            // Several controls can share one key, it is released only after the last of them.
+            int count = pressedCodes.getOrDefault(code, 0) + (down ? 1 : -1);
+            if (count <= 0)
+                pressedCodes.remove(code);
+            else
+                pressedCodes.put(code, count);
+            if ((down && count == 1) || (!down && count == 0))
+                sendRaw(code, down);
+        }
+    }
+
+    private void sendRaw(int code, boolean down) {
+        if (lorieView == null)
+            return;
+        if (code == WHEEL_UP || code == WHEEL_DOWN) {
+            if (down)
+                lorieView.sendMouseWheelEvent(0, code == WHEEL_UP ? -100 : 100);
+        } else if (code > MOUSE_BASE && code < MOUSE_BASE + 8)
+            lorieView.sendMouseEvent(0, 0, code - MOUSE_BASE, down, true);
+        else
+            lorieView.sendKeyEvent(0, code, down);
+    }
+
+    @Override
+    protected void onDraw(@NonNull Canvas canvas) {
+        if (controls.isEmpty())
+            return;
+        stroke.setStrokeWidth(Math.max(2f, unit * 0.05f));
+
+        drawToggle(canvas);
+        if (collapsed)
+            return;
+
+        for (Control c : controls) {
+            switch (c.kind) {
+                case BUTTON: drawRectButton(canvas, c); break;
+                case ROUND_BUTTON: drawRoundButton(canvas, c); break;
+                case STICK: drawStick(canvas, c); break;
+                case DPAD: drawDpad(canvas, c); break;
+            }
+        }
+    }
+
+    private void setFill(boolean pressed) {
+        fill.setColor(pressed ? 0xCCFFFFFF : 0x88000000);
+        stroke.setColor(0xDDFFFFFF);
+    }
+
+    private void drawLabel(Canvas canvas, String label, float x, float y, float size, int color) {
+        text.setTextSize(size);
+        text.setColor(color);
+        canvas.drawText(label, x, y - (text.descent() + text.ascent()) / 2, text);
+    }
+
+    private void drawToggle(Canvas canvas) {
+        fill.setColor(toggle.pressed ? 0xCCFFFFFF : 0x66000000);
+        stroke.setColor(collapsed ? 0x88FFFFFF : 0xDDFFFFFF);
+        canvas.drawCircle(toggle.cx, toggle.cy, toggle.r, fill);
+        canvas.drawCircle(toggle.cx, toggle.cy, toggle.r, stroke);
+        drawLabel(canvas, toggle.label, toggle.cx, toggle.cy, toggle.r, Color.WHITE);
+    }
+
+    private void drawRectButton(Canvas canvas, Control c) {
+        setFill(c.pressed);
+        float rad = c.rect.height() / 2;
+        // Triggers have a rounded top like on the real controller, bumpers are pills.
+        if (c.name.endsWith("T")) {
+            tmp.set(c.rect);
+            path.reset();
+            path.addRoundRect(tmp, new float[] { rad * 1.5f, rad * 1.5f, rad * 1.5f, rad * 1.5f, rad * 0.4f, rad * 0.4f, rad * 0.4f, rad * 0.4f }, Path.Direction.CW);
+            canvas.drawPath(path, fill);
+            canvas.drawPath(path, stroke);
+        } else {
+            canvas.drawRoundRect(c.rect, rad, rad, fill);
+            canvas.drawRoundRect(c.rect, rad, rad, stroke);
+        }
+        drawLabel(canvas, c.label, c.rect.centerX(), c.rect.centerY(), c.rect.height() * 0.5f, c.pressed ? Color.BLACK : Color.WHITE);
+    }
+
+    private void drawRoundButton(Canvas canvas, Control c) {
+        int accent = c.color == 0 ? Color.WHITE : c.color;
+        fill.setColor(c.pressed ? accent : 0x88000000);
+        stroke.setColor(c.color == 0 ? 0xDDFFFFFF : accent);
+        canvas.drawCircle(c.cx, c.cy, c.r, fill);
+        canvas.drawCircle(c.cx, c.cy, c.r, stroke);
+        float size = c.label.length() > 1 ? c.r * 0.8f : c.r * 1.1f;
+        drawLabel(canvas, c.label, c.cx, c.cy, size, c.pressed ? Color.BLACK : accent);
+    }
+
+    private void drawStick(Canvas canvas, Control c) {
+        boolean active = pointers.indexOfValue(c) >= 0;
+        fill.setColor(0x66000000);
+        stroke.setColor(0xAAFFFFFF);
+        canvas.drawCircle(c.cx, c.cy, c.r, fill);
+        canvas.drawCircle(c.cx, c.cy, c.r, stroke);
+        float kr = c.r * 0.45f, kx = c.cx + c.sx * (c.r - kr * 0.5f), ky = c.cy + c.sy * (c.r - kr * 0.5f);
+        fill.setColor(active ? 0xCCFFFFFF : 0xAA333333);
+        stroke.setColor(0xDDFFFFFF);
+        canvas.drawCircle(kx, ky, kr, fill);
+        canvas.drawCircle(kx, ky, kr, stroke);
+        canvas.drawCircle(kx, ky, kr * 0.7f, stroke);
+        drawLabel(canvas, c.name, kx, ky, kr * 0.6f, active ? Color.BLACK : Color.WHITE);
+    }
+
+    private void drawDpad(Canvas canvas, Control c) {
+        float a = c.r * 0.36f, l = c.r;
+        float[][] arms = {
+                { c.cx - a, c.cy - l, c.cx + a, c.cy - a }, // up
+                { c.cx - a, c.cy + a, c.cx + a, c.cy + l }, // down
+                { c.cx - l, c.cy - a, c.cx - a, c.cy + a }, // left
+                { c.cx + a, c.cy - a, c.cx + l, c.cy + a }, // right
+        };
+        fill.setColor(0x88000000);
+        path.reset();
+        path.addRect(c.cx - a, c.cy - l, c.cx + a, c.cy + l, Path.Direction.CW);
+        path.addRect(c.cx - l, c.cy - a, c.cx + l, c.cy + a, Path.Direction.CW);
+        path.setFillType(Path.FillType.WINDING);
+        canvas.drawPath(path, fill);
+        for (int i = 0; i < 4; i++) {
+            float[] r = arms[i];
+            if ((c.dirMask & (1 << i)) != 0) {
+                fill.setColor(0xCCFFFFFF);
+                canvas.drawRect(r[0], r[1], r[2], r[3], fill);
+            }
+        }
+        // Outline of the cross.
+        stroke.setColor(0xDDFFFFFF);
+        path.reset();
+        path.moveTo(c.cx - a, c.cy - l); path.lineTo(c.cx + a, c.cy - l); path.lineTo(c.cx + a, c.cy - a);
+        path.lineTo(c.cx + l, c.cy - a); path.lineTo(c.cx + l, c.cy + a); path.lineTo(c.cx + a, c.cy + a);
+        path.lineTo(c.cx + a, c.cy + l); path.lineTo(c.cx - a, c.cy + l); path.lineTo(c.cx - a, c.cy + a);
+        path.lineTo(c.cx - l, c.cy + a); path.lineTo(c.cx - l, c.cy - a); path.lineTo(c.cx - a, c.cy - a);
+        path.close();
+        canvas.drawPath(path, stroke);
+        // Arrows.
+        float t = a * 0.55f, o = l - a * 0.95f;
+        String[] glyphs = { "▲", "▼", "◀", "▶" };
+        float[][] pos = { { c.cx, c.cy - o }, { c.cx, c.cy + o }, { c.cx - o, c.cy }, { c.cx + o, c.cy } };
+        for (int i = 0; i < 4; i++)
+            drawLabel(canvas, glyphs[i], pos[i][0], pos[i][1], t * 1.6f, (c.dirMask & (1 << i)) != 0 ? Color.BLACK : 0xDDFFFFFF);
+    }
+}
