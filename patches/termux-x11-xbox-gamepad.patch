+    /** The virtual controller exists while the pad is shown in controller mode, games see it unplugged otherwise. */
+    private void updateBridge() {
+        boolean wanted = controllerOutput && getWindowToken() != null && getVisibility() == VISIBLE;
+        if (wanted && bridge == null) {
+            bridge = new XInputBridge(this::rumble);
+            bridge.start();
+            pushControllerState();
+        } else if (!wanted && bridge != null) {
+            bridge.stop();
+            bridge = null;
+        }
+    }
+
+    private void rumble(int left, int right) {
+        Vibrator vibrator = getContext().getSystemService(Vibrator.class);
+        if (vibrator == null)
+            return;
+        int amplitude = Math.max(left, right) >> 8;
+        if (amplitude == 0 || !haptics || bridge == null) {
+            vibrator.cancel();
+            return;
+        }
+        // Games set the motor speed and leave it running until they change it again.
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O)
+            vibrator.vibrate(VibrationEffect.createOneShot(10000, Math.max(1, amplitude)));
+        else
+            vibrator.vibrate(10000);
+    }
+
+    private static int controllerButton(String name) {
+        switch (name) {
+            case "A": return XInputBridge.A;
+            case "B": return XInputBridge.B;
+            case "X": return XInputBridge.X;
+            case "Y": return XInputBridge.Y;
+            case "LB": return XInputBridge.LEFT_SHOULDER;
+            case "RB": return XInputBridge.RIGHT_SHOULDER;
+            case "VIEW": return XInputBridge.BACK;
+            case "MENU": return XInputBridge.START;
+            case "LS": return XInputBridge.LEFT_THUMB;
+            case "RS": return XInputBridge.RIGHT_THUMB;
+            case "GUIDE": return XInputBridge.GUIDE;
+            default: return 0;
+        }
+    }
+
+    private static int axis(float value) {
+        return Math.round(Math.max(-1f, Math.min(1f, value)) * 32767);
+    }
+
+    private void pushControllerState() {
+        if (bridge == null)
+            return;
+        // XInput's Y axes point up.
+        bridge.update(xButtons, xLeftTrigger, xRightTrigger,
+                leftStick == null ? 0 : axis(leftStick.sx), leftStick == null ? 0 : axis(-leftStick.sy),
+                rightStick == null ? 0 : axis(rightStick.sx), rightStick == null ? 0 : axis(-rightStick.sy));
+    }
+
+    private Control findControl(float x, float y) {
+        if (toggle != null && toggle.hit(x, y))
+            return toggle;
+        if (collapsed)
+            return null;
+        return findPadControl(x, y, false);
+    }
+
+    private Control findPadControl(float x, float y, boolean includeHidden) {
+        Control best = null;
+        float bestDist = Float.MAX_VALUE;
+        for (Control c : controls) {
+            if (c.kind == Kind.TOGGLE || (c.hidden && !includeHidden) || !c.hit(x, y))
+                continue;
+            float d = c.kind == Kind.BUTTON ? Math.abs(x - c.rect.centerX()) + Math.abs(y - c.rect.centerY()) : (float) Math.hypot(x - c.cx, y - c.cy);
+            if (d < bestDist) {
+                bestDist = d;
+                best = c;
+            }
+        }
+        return best;
+    }
