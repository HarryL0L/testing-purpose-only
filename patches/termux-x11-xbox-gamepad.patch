+    @SuppressLint("ClickableViewAccessibility")
+    @Override
+    public boolean onTouchEvent(MotionEvent e) {
+        if (editing)
+            return onEditTouchEvent(e);
+        int action = e.getActionMasked();
+        int idx = e.getActionIndex();
+        switch (action) {
+            case MotionEvent.ACTION_DOWN:
+            case MotionEvent.ACTION_POINTER_DOWN: {
+                Control c = findControl(e.getX(idx), e.getY(idx));
+                if (c == null)
+                    return action != MotionEvent.ACTION_DOWN; // let first finger fall through to X server
+                pointers.put(e.getPointerId(idx), c);
+                if (c.kind == Kind.TOGGLE) {
+                    c.pressed = true;
+                    longPressFired = false;
+                    postDelayed(longPress, 600);
+                }
+                else if (c.kind == Kind.STICK || c.kind == Kind.DPAD)
+                    updateDirectional(c, e.getX(idx), e.getY(idx));
+                else
+                    setButton(c, true);
+                if (haptics)
+                    performHapticFeedback(HapticFeedbackConstants.VIRTUAL_KEY, HapticFeedbackConstants.FLAG_IGNORE_VIEW_SETTING);
+                invalidate();
+                return true;
+            }
+            case MotionEvent.ACTION_MOVE:
+                for (int i = 0; i < e.getPointerCount(); i++) {
+                    Control c = pointers.get(e.getPointerId(i));
+                    if (c != null && (c.kind == Kind.STICK || c.kind == Kind.DPAD))
+                        updateDirectional(c, e.getX(i), e.getY(i));
+                }
+                invalidate();
+                return true;
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_POINTER_UP: {
+                int id = e.getPointerId(idx);
+                Control c = pointers.get(id);
+                pointers.remove(id);
+                if (c != null) {
+                    if (c.kind == Kind.TOGGLE) {
+                        c.pressed = false;
+                        removeCallbacks(longPress);
+                        if (!longPressFired && toggle.hit(e.getX(idx), e.getY(idx)))
+                            toggleCollapsed();
+                    } else
+                        releaseControl(c);
+                }
+                invalidate();
+                return true;
+            }
+            case MotionEvent.ACTION_CANCEL:
+                removeCallbacks(longPress);
+                releaseAll();
+                return true;
+        }
+        return true;
+    }
+
+    private Control findById(String id) {
+        for (Control c : controls)
+            if (c.id.equals(id) && c.kind != Kind.TOGGLE)
+                return c;
+        return null;
+    }
+
+    private float[] layoutOf(String id) {
+        return layout.computeIfAbsent(id, k -> new float[] { 0, 0, 1, 0 });
+    }
+
+    private boolean onEditTouchEvent(MotionEvent e) {
+        int idx = e.getActionIndex();
+        switch (e.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+            case MotionEvent.ACTION_POINTER_DOWN: {
+                if (dragPointer != -1)
+                    return true;
+                float x = e.getX(idx), y = e.getY(idx);
+                for (int i = 0; i < tools.length; i++) {
+                    if (tools[i] != null && tools[i].contains(x, y)) {
+                        onTool(i);
+                        return true;
+                    }
+                }
+                Control c = findPadControl(x, y, true);
+                selectedId = c == null ? null : c.id;
+                if (c != null) {
+                    float[] t = layoutOf(c.id);
+                    dragPointer = e.getPointerId(idx);
+                    dragStartX = x;
+                    dragStartY = y;
+                    dragStartDx = t[LAYOUT_DX];
+                    dragStartDy = t[LAYOUT_DY];
+                    if (haptics)
+                        performHapticFeedback(HapticFeedbackConstants.VIRTUAL_KEY, HapticFeedbackConstants.FLAG_IGNORE_VIEW_SETTING);
+                }
+                invalidate();
+                return true;
+            }
+            case MotionEvent.ACTION_MOVE: {
+                int i = dragPointer == -1 ? -1 : e.findPointerIndex(dragPointer);
+                if (i < 0 || selectedId == null || unit <= 0)
+                    return true;
+                float[] t = layoutOf(selectedId);
+                t[LAYOUT_DX] = dragStartDx + (e.getX(i) - dragStartX) / unit;
+                t[LAYOUT_DY] = dragStartDy + (e.getY(i) - dragStartY) / unit;
+                layoutControls(getWidth(), getHeight());
+                // Store the position the control was clamped to, so it can not be dragged far off screen.
+                Control c = findById(selectedId);
+                if (c != null) {
+                    t[LAYOUT_DX] = (c.centerX() - c.defaultCx) / unit;
+                    t[LAYOUT_DY] = (c.centerY() - c.defaultCy) / unit;
+                }
+                invalidate();
+                return true;
+            }
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_POINTER_UP:
+                if (e.getPointerId(idx) == dragPointer)
+                    dragPointer = -1;
+                return true;
+            case MotionEvent.ACTION_CANCEL:
+                dragPointer = -1;
+                return true;
+        }
+        return true;
+    }
+
+    private void onTool(int tool) {
+        String label = TOOLS[tool];
+        if ("Done".equals(label)) {
+            setEditing(false);
+            return;
+        }
+        if ("Reset".equals(label)) {
+            if (selectedId != null)
+                layout.remove(selectedId);
+            else
+                layout.clear();
+        } else if (selectedId != null) {
+            float[] t = layoutOf(selectedId);
+            if ("−".equals(label))
+                t[LAYOUT_SCALE] = Math.max(0.5f, Math.round((t[LAYOUT_SCALE] - 0.1f) * 10) / 10f);
+            else if ("+".equals(label))
+                t[LAYOUT_SCALE] = Math.min(2.5f, Math.round((t[LAYOUT_SCALE] + 0.1f) * 10) / 10f);
+            else if ("Hide".equals(label))
+                t[LAYOUT_HIDDEN] = t[LAYOUT_HIDDEN] != 0 ? 0 : 1;
+        } else
+            return;
+        if (haptics)
+            performHapticFeedback(HapticFeedbackConstants.VIRTUAL_KEY, HapticFeedbackConstants.FLAG_IGNORE_VIEW_SETTING);
+        layoutControls(getWidth(), getHeight());
+        invalidate();
+    }
+
+    private void updateDirectional(Control c, float x, float y) {
+        float dx = (x - c.cx) / c.r, dy = (y - c.cy) / c.r;
+        float mag = (float) Math.hypot(dx, dy);
+        if (mag > 1) {
+            dx /= mag;
+            dy /= mag;
+            mag = 1;
+        }
+
+        int mask = 0;
+        if (c.kind == Kind.DPAD) {
+            // 8-way D-pad, with a small dead zone in the middle.
+            if (mag > 0.2f) {
+                double angle = Math.toDegrees(Math.atan2(dy, dx));
+                if (angle > -157.5 && angle < -22.5) mask |= 1;   // up
+                if (angle > 22.5 && angle < 157.5) mask |= 2;     // down
+                if (angle > 112.5 || angle < -112.5) mask |= 4;   // left
+                if (angle > -67.5 && angle < 67.5) mask |= 8;     // right
+            }
+            setDirections(c, mask, "DPAD");
+        } else {
+            c.sx = dx;
+            c.sy = dy;
+            if (controllerOutput) {
+                pushControllerState();
+                return;
+            }
+            String mode = c == leftStick ? leftStickMode : rightStickMode;
+            if ("keys".equals(mode)) {
+                if (dy < -STICK_DEADZONE) mask |= 1;
+                if (dy > STICK_DEADZONE) mask |= 2;
+                if (dx < -STICK_DEADZONE) mask |= 4;
+                if (dx > STICK_DEADZONE) mask |= 8;
+                setDirections(c, mask, c.name);
+            } else if ("mouse".equals(mode)) {
+                removeCallbacks(mouseTicker);
+                postOnAnimation(mouseTicker);
+            }
+        }
+    }
+
+    private static final String[] DIRS = { "_UP", "_DOWN", "_LEFT", "_RIGHT" };
+
+    private void setDirections(Control c, int mask, String prefix) {
+        int changed = mask ^ c.dirMask;
+        if (controllerOutput) {
+            // Direction bits are laid out like XInput's D-pad bits.
+            if (c.kind == Kind.DPAD && changed != 0) {
+                xButtons = (xButtons & ~0xF) | mask;
+                pushControllerState();
+            }
+        } else for (int i = 0; i < 4; i++) {
+            if ((changed & (1 << i)) == 0)
+                continue;
+            boolean down = (mask & (1 << i)) != 0;
+            sendCodes(mapping.get(prefix + DIRS[i]), down);
+        }
+        if (changed != 0 && mask != 0 && haptics && c.kind == Kind.DPAD)
+            performHapticFeedback(HapticFeedbackConstants.CLOCK_TICK, HapticFeedbackConstants.FLAG_IGNORE_VIEW_SETTING);
+        c.dirMask = mask;
+    }
+
+    private void setButton(Control c, boolean down) {
+        if (c.pressed == down)
+            return;
+        c.pressed = down;
+        if (!controllerOutput) {
+            sendCodes(mapping.get(c.name), down);
+            return;
+        }
+        if ("LT".equals(c.name))
+            xLeftTrigger = down ? 255 : 0;
+        else if ("RT".equals(c.name))
+            xRightTrigger = down ? 255 : 0;
+        else
+            xButtons = down ? xButtons | controllerButton(c.name) : xButtons & ~controllerButton(c.name);
+        pushControllerState();
+    }
+
+    private void releaseControl(Control c) {
+        if (c.kind == Kind.STICK || c.kind == Kind.DPAD) {
+            setDirections(c, 0, c.kind == Kind.DPAD ? "DPAD" : c.name);
+            c.sx = c.sy = 0;
+            pushControllerState();
+        } else
+            setButton(c, false);
+        c.pressed = false;
+    }
+
+    private void releaseAll() {
+        removeCallbacks(mouseTicker);
+        removeCallbacks(longPress);
+        pointers.clear();
+        for (Control c : controls) {
+            if (c.kind != Kind.TOGGLE)
+                releaseControl(c);
+            c.pressed = false;
+        }
+        // Anything still held (should not happen) is released too, so no key gets stuck in X server.
+        for (Integer code : new ArrayList<>(pressedCodes.keySet()))
+            sendRaw(code, false);
+        pressedCodes.clear();
+        xButtons = xLeftTrigger = xRightTrigger = 0;
+        pushControllerState();
+        invalidate();
+    }
+
+    private void sendCodes(int[] codes, boolean down) {
+        if (codes == null)
+            return;
+        // Press modifiers first and release them last.
+        for (int i = 0; i < codes.length; i++) {
+            int code = codes[down ? i : codes.length - 1 - i];
+            // Several controls can share one key, it is released only after the last of them.
+            int count = pressedCodes.getOrDefault(code, 0) + (down ? 1 : -1);
+            if (count <= 0)
+                pressedCodes.remove(code);
+            else
+                pressedCodes.put(code, count);
+            if ((down && count == 1) || (!down && count == 0))
+                sendRaw(code, down);
+        }
+    }
+
+    private void sendRaw(int code, boolean down) {
+        if (lorieView == null)
+            return;
+        if (code == WHEEL_UP || code == WHEEL_DOWN) {
+            if (down)
+                lorieView.sendMouseWheelEvent(0, code == WHEEL_UP ? -100 : 100);
+        } else if (code > MOUSE_BASE && code < MOUSE_BASE + 8)
+            lorieView.sendMouseEvent(0, 0, code - MOUSE_BASE, down, true);
+        else
+            lorieView.sendKeyEvent(0, code, down);
+    }
+
+    @Override
+    protected void onDraw(@NonNull Canvas canvas) {
+        if (controls.isEmpty())
+            return;
+        stroke.setStrokeWidth(Math.max(2f, unit * 0.05f));
+
+        if (editing) {
+            canvas.drawColor(0x66000000);
+        } else {
+            drawToggle(canvas);
+            if (collapsed)
+                return;
+        }
+
+        for (Control c : controls) {
+            if (c.kind == Kind.TOGGLE || (c.hidden && !editing))
+                continue;
+            if (c.hidden)
+                canvas.saveLayerAlpha(null, 70);
+            switch (c.kind) {
+                case BUTTON: drawRectButton(canvas, c); break;
+                case ROUND_BUTTON: drawRoundButton(canvas, c); break;
+                case STICK: drawStick(canvas, c); break;
+                case DPAD: drawDpad(canvas, c); break;
+            }
+            if (c.hidden)
+                canvas.restore();
+        }
+
+        if (editing)
+            drawEditor(canvas);
+    }
+
+    private void drawEditor(Canvas canvas) {
+        Control sel = selectedId == null ? null : findById(selectedId);
+        if (sel != null) {
+            stroke.setColor(0xFFFFD54F);
+            float pad = unit * 0.15f;
+            if (sel.kind == Kind.BUTTON)
+                tmp.set(sel.rect.left - pad, sel.rect.top - pad, sel.rect.right + pad, sel.rect.bottom + pad);
+            else
+                tmp.set(sel.cx - sel.r - pad, sel.cy - sel.r - pad, sel.cx + sel.r + pad, sel.cy + sel.r + pad);
+            canvas.drawRoundRect(tmp, pad, pad, stroke);
+        }
+
+        for (int i = 0; i < tools.length; i++) {
+            RectF r = tools[i];
+            if (r == null)
+                continue;
+            String label = TOOLS[i];
+            boolean enabled = sel != null || "Reset".equals(label) || "Done".equals(label);
+            if ("Hide".equals(label) && sel != null && sel.hidden)
+                label = "Show";
+            else if ("Reset".equals(label) && sel == null)
+                label = "Reset all";
+            fill.setColor("Done".equals(TOOLS[i]) ? 0xEE2E7D32 : 0xCC000000);
+            stroke.setColor(enabled ? 0xDDFFFFFF : 0x55FFFFFF);
+            canvas.drawRoundRect(r, r.height() / 2, r.height() / 2, fill);
+            canvas.drawRoundRect(r, r.height() / 2, r.height() / 2, stroke);
+            drawLabel(canvas, label, r.centerX(), r.centerY(), r.height() * (label.length() > 5 ? 0.32f : 0.42f), enabled ? Color.WHITE : 0x55FFFFFF);
+        }
+
+        RectF first = tools[0];
+        if (first != null) {
+            float[] t = sel == null ? null : layout.get(sel.id);
+            String hint = sel == null ? "Drag a control to move it, tap to select" : String.format(Locale.ROOT, "%s  ·  size %d%%", sel.id, Math.round((t == null ? 1 : t[LAYOUT_SCALE]) * 100));
+            drawLabel(canvas, hint, getWidth() / 2f, first.bottom + first.height() * 0.6f, first.height() * 0.38f, Color.WHITE);
+        }
+    }
+
+    private void setFill(boolean pressed) {
+        fill.setColor(pressed ? 0xCCFFFFFF : 0x88000000);
+        stroke.setColor(0xDDFFFFFF);
+    }
+
+    private void drawLabel(Canvas canvas, String label, float x, float y, float size, int color) {
+        text.setTextSize(size);
+        text.setColor(color);
+        canvas.drawText(label, x, y - (text.descent() + text.ascent()) / 2, text);
+    }
+
+    private void drawToggle(Canvas canvas) {
+        fill.setColor(toggle.pressed ? 0xCCFFFFFF : 0x66000000);
+        stroke.setColor(collapsed ? 0x88FFFFFF : 0xDDFFFFFF);
+        canvas.drawCircle(toggle.cx, toggle.cy, toggle.r, fill);
+        canvas.drawCircle(toggle.cx, toggle.cy, toggle.r, stroke);
+        drawLabel(canvas, toggle.label, toggle.cx, toggle.cy, toggle.r, Color.WHITE);
+    }
+
+    private void drawRectButton(Canvas canvas, Control c) {
+        setFill(c.pressed);
+        float rad = c.rect.height() / 2;
+        // Triggers have a rounded top like on the real controller, bumpers are pills.
+        if (c.name.endsWith("T")) {
+            tmp.set(c.rect);
+            path.reset();
+            path.addRoundRect(tmp, new float[] { rad * 1.5f, rad * 1.5f, rad * 1.5f, rad * 1.5f, rad * 0.4f, rad * 0.4f, rad * 0.4f, rad * 0.4f }, Path.Direction.CW);
+            canvas.drawPath(path, fill);
+            canvas.drawPath(path, stroke);
+        } else {
+            canvas.drawRoundRect(c.rect, rad, rad, fill);
+            canvas.drawRoundRect(c.rect, rad, rad, stroke);
+        }
+        drawLabel(canvas, c.label, c.rect.centerX(), c.rect.centerY(), c.rect.height() * 0.5f, c.pressed ? Color.BLACK : Color.WHITE);
+    }
+
+    private void drawRoundButton(Canvas canvas, Control c) {
+        int accent = c.color == 0 ? Color.WHITE : c.color;
+        fill.setColor(c.pressed ? accent : 0x88000000);
+        stroke.setColor(c.color == 0 ? 0xDDFFFFFF : accent);
+        canvas.drawCircle(c.cx, c.cy, c.r, fill);
+        canvas.drawCircle(c.cx, c.cy, c.r, stroke);
+        float size = c.label.length() > 1 ? c.r * 0.8f : c.r * 1.1f;
+        drawLabel(canvas, c.label, c.cx, c.cy, size, c.pressed ? Color.BLACK : accent);
+    }
+
+    private void drawStick(Canvas canvas, Control c) {
+        boolean active = pointers.indexOfValue(c) >= 0;
+        fill.setColor(0x66000000);
+        stroke.setColor(0xAAFFFFFF);
+        canvas.drawCircle(c.cx, c.cy, c.r, fill);
+        canvas.drawCircle(c.cx, c.cy, c.r, stroke);
+        float kr = c.r * 0.45f, kx = c.cx + c.sx * (c.r - kr * 0.5f), ky = c.cy + c.sy * (c.r - kr * 0.5f);
+        fill.setColor(active ? 0xCCFFFFFF : 0xAA333333);
+        stroke.setColor(0xDDFFFFFF);
+        canvas.drawCircle(kx, ky, kr, fill);
+        canvas.drawCircle(kx, ky, kr, stroke);
+        canvas.drawCircle(kx, ky, kr * 0.7f, stroke);
+        drawLabel(canvas, c.name, kx, ky, kr * 0.6f, active ? Color.BLACK : Color.WHITE);
+    }
+
+    private void drawDpad(Canvas canvas, Control c) {
+        float a = c.r * 0.36f, l = c.r;
+        float[][] arms = {
+                { c.cx - a, c.cy - l, c.cx + a, c.cy - a }, // up
+                { c.cx - a, c.cy + a, c.cx + a, c.cy + l }, // down
+                { c.cx - l, c.cy - a, c.cx - a, c.cy + a }, // left
+                { c.cx + a, c.cy - a, c.cx + l, c.cy + a }, // right
+        };
+        fill.setColor(0x88000000);
+        path.reset();
+        path.addRect(c.cx - a, c.cy - l, c.cx + a, c.cy + l, Path.Direction.CW);
+        path.addRect(c.cx - l, c.cy - a, c.cx + l, c.cy + a, Path.Direction.CW);
+        path.setFillType(Path.FillType.WINDING);
+        canvas.drawPath(path, fill);
+        for (int i = 0; i < 4; i++) {
+            float[] r = arms[i];
+            if ((c.dirMask & (1 << i)) != 0) {
+                fill.setColor(0xCCFFFFFF);
+                canvas.drawRect(r[0], r[1], r[2], r[3], fill);
+            }
+        }
+        // Outline of the cross.
+        stroke.setColor(0xDDFFFFFF);
+        path.reset();
+        path.moveTo(c.cx - a, c.cy - l); path.lineTo(c.cx + a, c.cy - l); path.lineTo(c.cx + a, c.cy - a);
+        path.lineTo(c.cx + l, c.cy - a); path.lineTo(c.cx + l, c.cy + a); path.lineTo(c.cx + a, c.cy + a);
+        path.lineTo(c.cx + a, c.cy + l); path.lineTo(c.cx - a, c.cy + l); path.lineTo(c.cx - a, c.cy + a);
+        path.lineTo(c.cx - l, c.cy + a); path.lineTo(c.cx - l, c.cy - a); path.lineTo(c.cx - a, c.cy - a);
+        path.close();
+        canvas.drawPath(path, stroke);
+        // Arrows.
+        float t = a * 0.55f, o = l - a * 0.95f;
+        String[] glyphs = { "▲", "▼", "◀", "▶" };
+        float[][] pos = { { c.cx, c.cy - o }, { c.cx, c.cy + o }, { c.cx - o, c.cy }, { c.cx + o, c.cy } };
+        for (int i = 0; i < 4; i++)
+            drawLabel(canvas, glyphs[i], pos[i][0], pos[i][1], t * 1.6f, (c.dirMask & (1 << i)) != 0 ? Color.BLACK : 0xDDFFFFFF);
+    }
+}
