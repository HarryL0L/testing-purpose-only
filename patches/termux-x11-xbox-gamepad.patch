+package com.termux.x11.input;
+
+import static com.termux.x11.input.InputStub.BUTTON_LEFT;
+import static com.termux.x11.input.InputStub.BUTTON_MIDDLE;
+import static com.termux.x11.input.InputStub.BUTTON_RIGHT;
+import static com.termux.x11.input.InputStub.BUTTON_UNDEFINED;
+
+import android.annotation.SuppressLint;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+import android.os.Build;
+import android.os.VibrationEffect;
+import android.os.Vibrator;
+import android.util.AttributeSet;
+import android.util.SparseArray;
+import android.view.HapticFeedbackConstants;
+import android.view.KeyEvent;
+import android.view.MotionEvent;
+import android.view.View;
+
+import androidx.annotation.NonNull;
+
+import com.termux.x11.LorieView;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.function.Consumer;
+
+/**
+ * Onscreen gamepad drawn in the Xbox controller layout: two analog sticks (with LS/RS clicks),
+ * D-pad, A/B/X/Y, LB/RB, LT/RT, View, Menu and Guide buttons.
+ * By default every control is translated to keyboard keys, mouse buttons, mouse wheel or relative
+ * mouse motion (user configurable), because X server has no virtual joystick device.
+ * In controller mode the pad is instead sent to the XInput bridge DLL in Wine, where games see
+ * a real Xbox controller with analog sticks (see {@link XInputBridge}).
+ * Touches that do not hit any control fall through to the views below.
+ * Long press on the toggle button enters layout editing mode, where controls can be moved,
+ * resized and hidden.
+ */
+public class GamepadOverlayView extends View {
+    public static final String DEFAULT_MAPPING =
+            "A=SPACE B=C X=R Y=E LB=Q RB=F LT=MOUSE_RIGHT RT=MOUSE_LEFT " +
+            "VIEW=TAB MENU=ESCAPE GUIDE=ENTER LS=SHIFT_LEFT RS=V " +
+            "DPAD_UP=UP DPAD_DOWN=DOWN DPAD_LEFT=LEFT DPAD_RIGHT=RIGHT " +
+            "LS_UP=W LS_DOWN=S LS_LEFT=A LS_RIGHT=D " +
+            "RS_UP=UP RS_DOWN=DOWN RS_LEFT=LEFT RS_RIGHT=RIGHT";
+
+    private static final int MOUSE_BASE = 0x10000;
+    private static final int WHEEL_UP = 0x20001, WHEEL_DOWN = 0x20002;
+    private static final float STICK_DEADZONE = 0.3f;
+    private static final int COLOR_A = 0xFF60B700, COLOR_B = 0xFFE81E25, COLOR_X = 0xFF2D7BD8, COLOR_Y = 0xFFF5C400;
+
+    private enum Kind { BUTTON, ROUND_BUTTON, STICK, DPAD, TOGGLE }
+
+    private class Control {
+        final Kind kind;
+        final String id, name, label; // id identifies the control in saved layout, name in mapping
+        final int color;
+        float cx, cy, r;           // round controls and D-pad
+        final RectF rect = new RectF(); // rectangular buttons
+        float defaultCx, defaultCy; // position before user's customization
+        boolean pressed, hidden;
+        float sx, sy;              // stick deflection, -1..1
+        int dirMask;               // currently pressed directions of stick or D-pad
+        Control(Kind kind, String id, String name, String label, int color) { this.kind = kind; this.id = id; this.name = name; this.label = label; this.color = color; }
+
+        float centerX() { return kind == Kind.BUTTON ? rect.centerX() : cx; }
+        float centerY() { return kind == Kind.BUTTON ? rect.centerY() : cy; }
+
+        boolean hit(float x, float y) {
+            if (kind == Kind.BUTTON)
+                return x >= rect.left - r * 0.25f && x <= rect.right + r * 0.25f && y >= rect.top - r * 0.25f && y <= rect.bottom + r * 0.25f;
+            float rr = (kind == Kind.STICK ? r * 1.35f : r * 1.12f);
+            return (x - cx) * (x - cx) + (y - cy) * (y - cy) <= rr * rr;
+        }
+    }
+
+    private final List<Control> controls = new ArrayList<>();
+    private final SparseArray<Control> pointers = new SparseArray<>();
+    private final Map<String, int[]> mapping = new HashMap<>();
+    private final Map<Integer, Integer> pressedCodes = new HashMap<>();
+    private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG), stroke = new Paint(Paint.ANTI_ALIAS_FLAG), text = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Path path = new Path();
+    private final RectF tmp = new RectF();
+    private Control leftStick, rightStick, dpad, toggle;
+    private LorieView lorieView;
+    private boolean collapsed = false, haptics = true;
+    private String leftStickMode = "keys", rightStickMode = "mouse";
+    private float sizeScale = 1f, mouseSpeed = 20f, mouseRemX, mouseRemY, unit;
+    private int insetTop, insetBottom;
+
+    // Xbox controller output.
+    private boolean controllerOutput;
+    private XInputBridge bridge;
+    private int xButtons, xLeftTrigger, xRightTrigger;
+
+    // Layout customization: id -> { dx, dy (in size units), scale, hidden (0 or 1) }.
+    private static final int LAYOUT_DX = 0, LAYOUT_DY = 1, LAYOUT_SCALE = 2, LAYOUT_HIDDEN = 3;
+    private static final String[] TOOLS = { "−", "+", "Hide", "Reset", "Done" };
+    private final Map<String, float[]> layout = new HashMap<>();
+    private final RectF[] tools = new RectF[TOOLS.length];
+    private Consumer<String> onLayoutSaved;
+    private boolean editing, longPressFired;
+    private String selectedId;
+    private int dragPointer = -1;
+    private float dragStartX, dragStartY, dragStartDx, dragStartDy;
+    private final Runnable longPress = () -> {
+        longPressFired = true;
+        setEditing(true);
+    };
+
+    private final Runnable mouseTicker = new Runnable() {
+        @Override public void run() {
+            boolean active = false;
+            for (Control c : new Control[] { leftStick, rightStick }) {
+                if (c == null || !"mouse".equals(c == leftStick ? leftStickMode : rightStickMode))
+                    continue;
+                float mag = (float) Math.hypot(c.sx, c.sy);
+                if (mag < 0.08f)
+                    continue;
+                active = true;
+                // Quadratic response curve gives precise aiming near center and fast turns at the edge.
+                float k = mouseSpeed * mag;
+                mouseRemX += c.sx * k;
+                mouseRemY += c.sy * k;
+            }
+            int dx = (int) mouseRemX, dy = (int) mouseRemY;
+            mouseRemX -= dx;
+            mouseRemY -= dy;
+            if ((dx != 0 || dy != 0) && lorieView != null)
+                lorieView.sendMouseEvent(dx, dy, BUTTON_UNDEFINED, false, true);
+            if (active)
+                postOnAnimation(this);
+            else
+                mouseRemX = mouseRemY = 0;
+        }
+    };
+
+    public GamepadOverlayView(Context context) { this(context, null); }
+    public GamepadOverlayView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        stroke.setStyle(Paint.Style.STROKE);
+        text.setTextAlign(Paint.Align.CENTER);
+        text.setFakeBoldText(true);
+        setMapping(DEFAULT_MAPPING);
+    }
+
+    public void setLorieView(LorieView view) { lorieView = view; }
+
+    public void setOnLayoutSaved(Consumer<String> listener) { onLayoutSaved = listener; }
+
+    public void configure(float scale, String leftMode, String rightMode, int speed, boolean vibrate, String mappingString, String layoutString, boolean controller) {
+        releaseAll();
+        controllerOutput = controller;
+        updateBridge();
+        if (!editing)
+            parseLayout(layoutString);
+        sizeScale = scale;
+        leftStickMode = leftMode;
+        rightStickMode = rightMode;
+        mouseSpeed = Math.max(1, speed) * 0.5f;
+        haptics = vibrate;
+        setMapping(mappingString);
+        layoutControls(getWidth(), getHeight());
+        invalidate();
+    }
+
+    public void toggleCollapsed() {
+        releaseAll();
+        collapsed = !collapsed;
+        invalidate();
+    }
+
+    public void setEditing(boolean edit) {
+        if (edit == editing)
+            return;
+        releaseAll();
+        editing = edit;
+        collapsed = false;
+        selectedId = null;
+        dragPointer = -1;
+        if (!edit && onLayoutSaved != null)
+            onLayoutSaved.accept(serializeLayout());
+        if (haptics)
+            performHapticFeedback(HapticFeedbackConstants.LONG_PRESS, HapticFeedbackConstants.FLAG_IGNORE_VIEW_SETTING);
+        layoutControls(getWidth(), getHeight());
+        invalidate();
+    }
+
+    private void parseLayout(String str) {
+        layout.clear();
+        if (str == null)
+            return;
+        for (String entry : str.split(";")) {
+            String[] f = entry.trim().split(":");
+            if (f.length != 5)
+                continue;
+            try {
+                layout.put(f[0], new float[] { Float.parseFloat(f[1]), Float.parseFloat(f[2]), Float.parseFloat(f[3]), Float.parseFloat(f[4]) });
+            } catch (NumberFormatException ignored) {}
+        }
+    }
+
+    private String serializeLayout() {
+        StringBuilder sb = new StringBuilder();
+        for (Map.Entry<String, float[]> e : layout.entrySet()) {
+            float[] t = e.getValue();
+            if (t[LAYOUT_DX] == 0 && t[LAYOUT_DY] == 0 && t[LAYOUT_SCALE] == 1 && t[LAYOUT_HIDDEN] == 0)
+                continue;
+            if (sb.length() > 0)
+                sb.append(';');
+            sb.append(String.format(Locale.ROOT, "%s:%.3f:%.3f:%.2f:%d", e.getKey(), t[LAYOUT_DX], t[LAYOUT_DY], t[LAYOUT_SCALE], (int) t[LAYOUT_HIDDEN]));
+        }
+        return sb.toString();
+    }
+
+    private void setMapping(String str) {
+        mapping.clear();
+        parseMapping(DEFAULT_MAPPING);
+        if (str != null)
+            parseMapping(str);
+    }
+
+    private void parseMapping(String str) {
+        for (String token : str.trim().split("[\\s,;]+")) {
+            int eq = token.indexOf('=');
+            if (eq <= 0)
+                continue;
+            String name = token.substring(0, eq).trim().toUpperCase(Locale.ROOT);
+            String[] parts = token.substring(eq + 1).split("\\+");
+            List<Integer> codes = new ArrayList<>();
+            for (String p : parts) {
+                int code = parseCode(p.trim().toUpperCase(Locale.ROOT));
+                if (code != 0)
+                    codes.add(code);
+            }
+            mapping.put(name, codes.stream().mapToInt(Integer::intValue).toArray());
+        }
+    }
+
+    private static int parseCode(String s) {
+        switch (s) {
+            case "": case "NONE": return 0;
+            case "MOUSE_LEFT": return MOUSE_BASE + BUTTON_LEFT;
+            case "MOUSE_MIDDLE": return MOUSE_BASE + BUTTON_MIDDLE;
+            case "MOUSE_RIGHT": return MOUSE_BASE + BUTTON_RIGHT;
+            case "WHEEL_UP": return WHEEL_UP;
+            case "WHEEL_DOWN": return WHEEL_DOWN;
+            case "ESC": s = "ESCAPE"; break;
+            case "SHIFT": s = "SHIFT_LEFT"; break;
+            case "CTRL": s = "CTRL_LEFT"; break;
+            case "ALT": s = "ALT_LEFT"; break;
+            case "UP": case "DOWN": case "LEFT": case "RIGHT": s = "DPAD_" + s; break;
+            case "RETURN": s = "ENTER"; break;
+            case "BACKSPACE": case "BKSP": s = "DEL"; break;
+            case "DELETE": s = "FORWARD_DEL"; break;
+            case "PGUP": s = "PAGE_UP"; break;
+            case "PGDN": s = "PAGE_DOWN"; break;
+            case "END": s = "MOVE_END"; break;
+            case "HOME": s = "MOVE_HOME"; break;
+        }
+        int code = KeyEvent.keyCodeFromString(s.startsWith("KEYCODE_") ? s : "KEYCODE_" + s);
+        return code == KeyEvent.KEYCODE_UNKNOWN ? 0 : code;
+    }
+
+    /** Keeps the pad clear of the extra keys bar, which is drawn over this view. */
+    public void setInsets(int top, int bottom) {
+        if (top == insetTop && bottom == insetBottom)
+            return;
+        insetTop = top;
+        insetBottom = bottom;
+        releaseAll();
+        layoutControls(getWidth(), getHeight());
+        invalidate();
+    }
+
+    private void layoutControls(int w, int fullHeight) {
+        controls.clear();
+        if (w == 0 || fullHeight == 0)
+            return;
+
+        // Controls are laid out from the bottom edge of the area left free by the insets.
+        int avail = fullHeight - insetTop - insetBottom, h = fullHeight - insetBottom;
+        if (avail <= 0)
+            return;
+        float u = unit = unit(w, avail), u0 = Math.min(avail / 10f, w / 17f);
+        float br = 0.6f * u, sr = 0.42f * u;
+
+        Control lt = add(Kind.BUTTON, "LT", "LT", 0), lb = add(Kind.BUTTON, "LB", "LB", 0);
+        Control rt = add(Kind.BUTTON, "RT", "RT", 0), rb = add(Kind.BUTTON, "RB", "RB", 0);
+        lt.rect.set(0.5f * u, h - 8.8f * u, 3.0f * u, h - 7.8f * u);
+        lb.rect.set(0.5f * u, h - 7.5f * u, 3.7f * u, h - 6.5f * u);
+        rt.rect.set(w - 3.0f * u, h - 8.8f * u, w - 0.5f * u, h - 7.8f * u);
+        rb.rect.set(w - 3.7f * u, h - 7.5f * u, w - 0.5f * u, h - 6.5f * u);
+        lt.r = lb.r = rt.r = rb.r = u;
+
+        leftStick = add(Kind.STICK, "LSTICK", "LS", "", 0);
+        place(leftStick, 2.6f * u, h - 4.4f * u, 1.5f * u);
+        rightStick = add(Kind.STICK, "RSTICK", "RS", "", 0);
+        place(rightStick, w - 6.2f * u, h - 1.9f * u, 1.3f * u);
+
+        dpad = add(Kind.DPAD, "DPAD", "", 0);
+        place(dpad, 6.2f * u, h - 1.9f * u, 1.6f * u);
+
+        float ax = w - 2.6f * u, ay = h - 4.4f * u, off = 1.15f * u;
+        place(add(Kind.ROUND_BUTTON, "Y", "Y", COLOR_Y), ax, ay - off, br);
+        place(add(Kind.ROUND_BUTTON, "X", "X", COLOR_X), ax - off, ay, br);
+        place(add(Kind.ROUND_BUTTON, "B", "B", COLOR_B), ax + off, ay, br);
+        place(add(Kind.ROUND_BUTTON, "A", "A", COLOR_A), ax, ay + off, br);
+
+        float mx = w / 2f, my = h - 4.4f * u;
+        place(add(Kind.ROUND_BUTTON, "LS", "LS", 0), mx - 3.2f * u, my, sr);
+        place(add(Kind.ROUND_BUTTON, "VIEW", "⧉", 0), mx - 1.5f * u, my, sr);
+        place(add(Kind.ROUND_BUTTON, "GUIDE", "Ⓧ", 0xFFFFFFFF), mx, my, 0.55f * u);
+        place(add(Kind.ROUND_BUTTON, "MENU", "≡", 0), mx + 1.5f * u, my, sr);
+        place(add(Kind.ROUND_BUTTON, "RS", "RS", 0), mx + 3.2f * u, my, sr);
+
+        for (Control c : controls)
+            applyCustomization(c, u, w, fullHeight);
+
+        toggle = add(Kind.TOGGLE, "TOGGLE", "🎮", 0);
+        place(toggle, w / 2f, insetTop + 0.6f * u0, 0.45f * u0);
+
+        // Editing toolbar, centered at the top.
+        float tw = 1.9f * u0, th = 0.9f * u0, gap = 0.2f * u0;
+        float tx = w / 2f - (TOOLS.length * tw + (TOOLS.length - 1) * gap) / 2, ty = insetTop + 0.25f * u0;
+        for (int i = 0; i < TOOLS.length; i++)
+            tools[i] = new RectF(tx + i * (tw + gap), ty, tx + i * (tw + gap) + tw, ty + th);
+    }
+
+    private void applyCustomization(Control c, float u, int w, int h) {
+        c.defaultCx = c.centerX();
+        c.defaultCy = c.centerY();
+        float[] t = layout.get(c.id);
+        if (t == null)
+            return;
+        float scale = t[LAYOUT_SCALE];
+        c.hidden = t[LAYOUT_HIDDEN] != 0;
+        float x = c.defaultCx + t[LAYOUT_DX] * u, y = c.defaultCy + t[LAYOUT_DY] * u;
+        if (c.kind == Kind.BUTTON) {
+            float hw = c.rect.width() * scale / 2, hh = c.rect.height() * scale / 2;
+            x = clamp(x, hw, w - hw);
+            y = clamp(y, hh, h - hh);
+            c.rect.set(x - hw, y - hh, x + hw, y + hh);
+            c.r *= scale;
+        } else {
+            c.r *= scale;
+            c.cx = clamp(x, c.r, w - c.r);
+            c.cy = clamp(y, c.r, h - c.r);
+        }
+    }
+
+    private static float clamp(float v, float min, float max) {
+        return max < min ? (min + max) / 2 : Math.max(min, Math.min(max, v));
+    }
+
+    /** Base size unit; the size preference can enlarge it only as long as the whole layout still fits the screen. */
+    private float unit(int w, int h) {
+        return Math.min(Math.min(h / 10f, w / 17f) * sizeScale, Math.min(h / 9.4f, w / 16f));
+    }
